# GM800 国美云触屏音箱 (GM260200482)
#
# 注意：quirks 的目录名必须与设备树 /model 字符串一致
#       （运行时 QUIRK_DEVICE 取自 /sys/firmware/devicetree/base/model，
#         "/" 会被替换成 "-"）
#       本目录名对应 mainline/rk3566-guomeiyun.dts 里的：
#           model = "GM800 Guomeiyun Smart Speaker";

cat <<EOF >/storage/.config/profile.d/001-device_config
DEVICE_RK="RK3566"
DEVICE_FAKE_JACKSENSE="false"
DEVICE_HAS_TOUCHSCREEN="true"

# 800x1280 竖屏
DEVICE_ASPECT_RATIO="800/1280"

# LED 交给内核的 gpio-leds 驱动（gpio0 RK_PB2 常亮 / gpio0 RK_PC3 heartbeat），
# 不要启用用户态 ledcontrol，否则会和 gpio-leds 抢 GPIO
DEVICE_LED_CONTROL="false"
DEVICE_LED_BRIGHTNESS="false"
DEVICE_PWR_LED_CONTROL="false"

DEVICE_VOLUME="100"
EOF
